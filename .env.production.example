# Copy this file to .env.production on the deployment host. Never commit the copy.
NODE_ENV=production
PUBLIC_HOST=app.example.com
PUBLIC_ORIGIN=https://app.example.com

POSTGRES_DB=together
POSTGRES_USER=together
POSTGRES_PASSWORD=generate-a-long-unique-password

GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_OAUTH_REDIRECT_URL=https://app.example.com/auth/github/callback
JWT_SECRET=generate-a-base64-encoded-32-byte-key
TOKEN_ENCRYPTION_KEY=generate-a-different-base64-encoded-32-byte-key

MINIO_ACCESS_KEY=generate-a-unique-minio-access-key
MINIO_SECRET_KEY=generate-a-unique-minio-secret-key
MINIO_BUCKET=together-datasets
WORKSPACE_RUNTIME_IMAGE=registry.example.com/together-runtime:version
WORKSPACE_VOLUME_NAME=together_workspace_data_production
TRUST_PROXY=true
DOCKER_HOST=http://docker-proxy:2375
