# Docker Compose service configuration
POSTGRES_DB=together
POSTGRES_USER=together
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# Application configuration
SERVER_PORT=4000
CLIENT_PORT=5173
CORS_ORIGIN=http://localhost:5173
VITE_API_PROXY_TARGET=http://server:4000
# Comma-separated hostnames allowed to access the browser client. Add a public
# tunnel hostname here when using ngrok or a port-forwarding URL.
VITE_ALLOWED_HOSTS=localhost
WORKSPACE_ROOT=/data/workspaces
WORKSPACE_CLONE_TIMEOUT_MS=120000
INVITE_TTL_HOURS=168
# File API safety limits (bytes / maximum nodes).
MAX_FILE_OPEN_BYTES=1048576
FILE_TREE_MAX_ENTRIES=10000
COLLABORATION_PERSIST_DEBOUNCE_MS=1500
COLLABORATION_DOC_UNLOAD_MS=30000

# Phase 2 shared workspace runtime limits. The Docker socket is mounted only
# into the Together server so it can create restricted runtime containers; it
# is never mounted into any workspace runtime container.
WORKSPACE_RUNTIME_IMAGE=together-workspace-runtime:local
WORKSPACE_VOLUME_NAME=together_workspace_data
WORKSPACE_RUNTIME_MEMORY_MB=768
WORKSPACE_RUNTIME_CPU_COUNT=1
WORKSPACE_RUNTIME_PIDS_LIMIT=128
WORKSPACE_RUNTIME_IDLE_MS=900000

# Host-side Prisma commands use localhost; Docker overrides this to use the postgres service.
DATABASE_URL=postgresql://together:replace-with-a-local-development-password@localhost:5432/together?schema=public

# GitHub OAuth — create an OAuth App before using authentication.
# For a public tunnel, replace both URLs with the exact public HTTPS origin.
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:4000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:4000/auth/github/callback
# Each value must be an independently generated Base64-encoded 32-byte secret.
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
