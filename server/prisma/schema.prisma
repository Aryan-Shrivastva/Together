generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceStatus {
  CLONING
  READY
  ERROR
}

enum WorkspaceRole {
  OWNER
  COLLABORATOR
  VIEWER
}

enum WorkspaceRuntimeStatus {
  STOPPED
  STARTING
  RUNNING
  ERROR
}

enum PreviewStatus {
  STOPPED
  STARTING
  RUNNING
  ERROR
}

model User {
  id                          String            @id @default(cuid())
  githubId                    String            @unique
  username                    String
  avatarUrl                   String
  email                       String?
  githubAccessTokenEncrypted  String
  createdAt                   DateTime          @default(now())
  ownedWorkspaces             Workspace[]       @relation("WorkspaceOwner")
  memberships                 WorkspaceMember[]
  createdInvites              Invite[]          @relation("InviteCreator")
  chatMessages                ChatMessage[]
  activityLogs                ActivityLog[]
}

model Workspace {
  id            String            @id @default(cuid())
  name          String
  repoFullName  String
  repoCloneUrl  String
  defaultBranch String
  ownerId       String
  diskPath      String
  status        WorkspaceStatus   @default(CLONING)
  createdAt     DateTime          @default(now())
  owner         User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       WorkspaceMember[]
  invites       Invite[]
  chatMessages  ChatMessage[]
  runtime       WorkspaceRuntime?
  config        WorkspaceConfig[]
  datasets      Dataset[]
  branches      Branch[]
  preview       Preview?
  activityLogs  ActivityLog[]

  @@index([ownerId])
}

model Preview {
  id                String        @id @default(cuid())
  workspaceId       String        @unique
  dockerContainerId String?       @unique
  dockerNetworkId   String?
  port              Int
  status            PreviewStatus @default(STOPPED)
  lastError         String?
  startedAt         DateTime?
  updatedAt         DateTime      @updatedAt
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model Branch {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  task        String
  createdById String
  worktreePath String @unique
  branchWorkspaceId String? @unique
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model WorkspaceConfig {
  id             String    @id @default(cuid())
  workspaceId    String
  key            String
  encryptedValue String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model Dataset {
  id           String    @id @default(cuid())
  workspaceId  String
  objectKey    String    @unique
  originalName String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model WorkspaceRuntime {
  id                    String                 @id @default(cuid())
  workspaceId           String                 @unique
  dockerContainerId     String?                @unique
  dockerNetworkId       String?
  status                WorkspaceRuntimeStatus @default(STOPPED)
  dependencyFingerprint String?
  lastError             String?
  startedAt             DateTime?
  updatedAt             DateTime               @updatedAt
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique
  createdById String
  inviteRole WorkspaceRole @default(COLLABORATOR)
  expiresAt   DateTime
  revoked     Boolean   @default(false)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdById])
}

model ChatMessage {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  content     String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([userId])
}

model ActivityLog {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  details     String?
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}
